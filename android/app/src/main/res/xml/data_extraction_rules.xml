<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for the cloud backup and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="app_flutter/endelea.sqlite" />
        <include domain="file" path="app_flutter/endelea.sqlite-wal" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="app_flutter/endelea.sqlite" />
        <include domain="file" path="app_flutter/endelea.sqlite-wal" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
